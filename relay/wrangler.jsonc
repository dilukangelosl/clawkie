{
  "name": "clawkie-relay",
  "main": "index.js",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "a7557e34e650282d40e6bb2591d61e9f",
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "Relay" }] },
  "workers_dev": true,
  "d1_databases": [{ "binding": "DB", "database_name": "clawkie", "database_id": "c70fa0d6-8fc4-42a2-b524-bff7343ed436" }],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ],
  // landing page, auth pages, dashboard; the worker runs first so /api and the relay routes reach it
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "drop-trailing-slash" },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@clawkie.xyz"] }],
  // BETTER_AUTH_SECRET is a secret: wrangler secret put BETTER_AUTH_SECRET (and .dev.vars locally)
  "vars": { "BASE_URL": "https://clawkie.xyz", "MAIL_FROM": "noreply@clawkie.xyz" },
  "routes": [
    { "pattern": "relay.clawkie.xyz", "custom_domain": true },
    { "pattern": "clawkie.xyz", "custom_domain": true }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }]
}
